# ==============================================================================
# TRINETRA Frontend Configuration
# ==============================================================================
# SECURE REVERSE PROXY:
# In Vercel Project Settings -> Environment Variables, set BACKEND_URL
# (WITHOUT NEXT_PUBLIC_ prefix).
# Next.js will proxy all /api/* calls server-side, hiding the Azure VM IP
# and terminating HTTPS cleanly without mixed-content errors.
BACKEND_URL=http://20.235.243.147:8000

# Native Globe Route
NEXT_PUBLIC_TRINETRA_URL=/explore

# Supabase (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

