# SatQuery AI — 100% Local Agentic AI Configuration
# Indian Space Research Organisation (ISRO) • Problem Statement 26167
# NO CLOUD LLM KEYS REQUIRED (Zero Gemini / OpenAI / Anthropic)

# Local Ollama Service Configuration
OLLAMA_HOST=http://localhost:11434

# Local Model Roles
# Download models via:
#   ollama pull qwen3.5:9b
#   ollama pull qwen3.5:4b
#   ollama pull llama3.2
SATQUERY_PLANNER_MODEL=qwen3.5:9b
SATQUERY_ROUTER_MODEL=qwen3.5:4b
SATQUERY_LIGHT_MODEL=llama3.2

# Langfuse Observability & Tracing (Optional / Non-blocking)
# If unconfigured or offline, local memory tracing safely persists traces
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-telemetry
LANGFUSE_SECRET_KEY=sk-lf-local-telemetry

# Server Runtime Settings
HOST=127.0.0.1
PORT=8000
